{
  "info": {
    "name": "Resume RAG Retrieval — Phase 6: Vector Search",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /v1/search/vector — happy path",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"senior engineer who has built safe RAG and LLM evaluation systems\",\n  \"topK\": 20\n}"
        },
        "url": {
          "raw": "http://localhost:3000/v1/search/vector",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["v1", "search", "vector"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('mode is vector', () => pm.expect(body.mode).to.eql('vector'));",
              "pm.test('results is an array', () => pm.expect(body.results).to.be.an('array'));",
              "pm.test('count matches results length', () => pm.expect(body.count).to.eql(body.results.length));",
              "if (body.results.length > 0) {",
              "  const r = body.results[0];",
              "  pm.test('result has resumeId', () => pm.expect(r.resumeId).to.be.a('string'));",
              "  pm.test('vectorScore is a number between 0 and 1', () => {",
              "    pm.expect(r.vectorScore).to.be.a('number');",
              "    pm.expect(r.vectorScore).to.be.within(0, 1);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK — example",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"mode\": \"vector\",\n  \"count\": 1,\n  \"results\": [\n    {\n      \"resumeId\": \"691db80aa895776f97b6eca6\",\n      \"name\": \"Rajesh Mohan Kumar\",\n      \"role\": \"Test Architect & Senior Agentic Test Engineer\",\n      \"vectorScore\": 0.88\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "POST /v1/search/vector — with minYearsExperience filter",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"agentic QA architect with RAG evaluation\",\n  \"topK\": 20,\n  \"filters\": {\n    \"minYearsExperience\": 10\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3000/v1/search/vector",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["v1", "search", "vector"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('mode is vector', () => pm.expect(body.mode).to.eql('vector'));",
              "body.results.forEach(r => {",
              "  pm.test(`${r.name} vectorScore is a number`, () => pm.expect(r.vectorScore).to.be.a('number'));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "POST /v1/search/vector — semantically similar (different wording)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"GenAI quality assurance specialist with experience in automated LLM testing frameworks\",\n  \"topK\": 10\n}"
        },
        "url": {
          "raw": "http://localhost:3000/v1/search/vector",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["v1", "search", "vector"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('mode is vector', () => pm.expect(body.mode).to.eql('vector'));",
              "pm.test('semantic match returns at least 1 result', () => pm.expect(body.count).to.be.at.least(1));"
            ]
          }
        }
      ],
      "response": []
    },
