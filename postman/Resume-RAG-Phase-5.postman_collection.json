{
  "info": {
    "name": "Resume RAG - Phase 5",
    "description": "Verification requests for PDF resume text extraction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "POST Resume Extract - Valid PDF",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/v1/resume/extract",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "resume", "extract"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Text was extracted', function () { var body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.rawText).to.be.a('string').and.not.empty; pm.expect(body.characters).to.be.above(0); });",
              "pm.test('Request ID header exists', function () { pm.expect(pm.response.headers.has('x-request-id')).to.eql(true); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST Resume Extract - Missing File",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": []
        },
        "url": {
          "raw": "{{baseUrl}}/v1/resume/extract",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "resume", "extract"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Missing file is rejected', function () { var body = pm.response.json(); pm.expect(body.success).to.eql(false); pm.expect(body.errorCode).to.eql('MISSING_FILE'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
